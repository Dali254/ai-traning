# ─────────────────────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, add each of these
# under Project → Settings → Environment Variables.
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# ── Postgres (Neon / Lakebase) ──────────────────────────────
# `neon env pull` writes both of these for you.
#
# DATABASE_URL          POOLED  (hostname has -pooler). All app query traffic.
# DATABASE_URL_UNPOOLED DIRECT  (no -pooler). Migrations, dumps, LISTEN/NOTIFY.
#
# Use the pooled one for the app: serverless means many short-lived instances,
# and PgBouncer multiplexes them onto far fewer Postgres backends.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── M-Pesa via LipaLink / PesaFlux ──────────────────────────
# From the LipaLink dashboard → Integration. This single key is
# BOTH the X-Api-Key header value AND the webhook HMAC secret.
PESAFLUX_API_KEY=
# The business you are collecting into (Integration → Step 1)
PESAFLUX_BUSINESS_ID=
# Endpoints (override only if LipaLink changes them)
PESAFLUX_STK_URL=https://lipalink.co.ke/api/stk_push.php
PESAFLUX_STATUS_URL=https://lipalink.co.ke/api/transaction_status.php

# ── Claude API, for admin task generation ───────────────────
# Optional: leave blank and the Generate Tasks button stays disabled.
ANTHROPIC_API_KEY=

# ── Cron protection ─────────────────────────────────────────
# Vercel sends this as a Bearer token on scheduled invocations.
# Generate like SESSION_SECRET above.
CRON_SECRET=

# Public base URL, used to build the webhook URL you paste into LipaLink.
# e.g. https://ai-trainer-hub.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
